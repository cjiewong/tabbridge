{
  "manifest_version": 3,
  "name": "TabBridge",
  "version": "0.2.0",
  "description": "Connect CLI agents to the Chrome tabs you explicitly share. Local-only, open source.",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabBridge — tab access",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "minimum_chrome_version": "118",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
